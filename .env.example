# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================================================
SERVER_PORT=8081

# ==============================================================================
# BASE DE DATOS (DATASOURCE & JPA)
# ==============================================================================
# Configuración por defecto: H2 en memoria (desarrollo / testing)
DB_URL=jdbc:h2:mem:bibliotecadb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
H2_CONSOLE_ENABLED=true
JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Ejemplo alternativo para PostgreSQL (descomentar para producción / docker):
# DB_URL=jdbc:postgresql://localhost:5432/biblioteca_db
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=postgres
# DB_PASSWORD=tu_password_aqui
# H2_CONSOLE_ENABLED=false
# JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
# JPA_DDL_AUTO=validate

# ==============================================================================
# SEGURIDAD JWT (JSON WEB TOKENS)
# ==============================================================================
# Clave secreta HMAC-SHA256 (mínimo 256 bits / 32 bytes en formato hex o base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiración del Access Token en milisegundos (ej: 900000 = 15 minutos)
JWT_EXPIRATION=900000
# Expiración del Refresh Token en milisegundos (ej: 604800000 = 7 días)
JWT_REFRESH_EXPIRATION=604800000

# ==============================================================================
# PROVEEDOR DE EMAIL (SMTP / JAVAMAILSENDER)
# ==============================================================================
# Configuración SMTP (ej: localhost, smtp.gmail.com, sandbox.smtp.mailtrap.io)
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=noreply@biblioteca.com

# Ejemplo para Mailtrap (Pruebas SMTP seguras):
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=tu_mailtrap_user
# MAIL_PASSWORD=tu_mailtrap_password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=soporte@biblioteca.com

# Ejemplo para Gmail SMTP (usando App Password):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=tu_app_password_generado
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=tu_correo@gmail.com

# ==============================================================================
# GOOGLE BOOKS API (INTEGRACIÓN EXTERNA)
# ==============================================================================
GOOGLE_BOOKS_API_KEY=your_api_key_here
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1

# ==============================================================================
# TAREAS PROGRAMADAS (SCHEDULERS)
# ==============================================================================
# Expresión cron para el recordatorio diario de préstamos a vencer (por defecto: 08:00 AM)
LOAN_REMINDER_CRON=0 0 8 * * *
